PORT=5050
MONGO_URI=mongodb://127.0.0.1:27018/meetscribe
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=500

# Local Whisper (server-side transcription). Set up with: npm run setup:whisper
WHISPER_ENABLED=true
# Transcribe automatically after each recording/import
WHISPER_AUTO=true
# tiny | base | small | medium | large-v3 | distil-large-v3 (bigger = more accurate, slower)
WHISPER_MODEL=small
# auto | cpu | cuda
WHISPER_DEVICE=auto
# int8 is fastest on CPU; use float16 on NVIDIA GPUs
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=0
# WHISPER_PYTHON=worker/.venv/bin/python
# WHISPER_MODEL_DIR=worker/models
